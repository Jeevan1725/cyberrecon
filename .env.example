# CyberRecon Environment Configuration
# Copy to .env and fill in real values.

# --- C2 Server ---
C2_HOST=0.0.0.0
C2_PORT=8443
CYBERRECON_OPERATOR_TOKEN=change-me-to-a-long-random-string
CYBERRECON_REQUIRE_AUTH=true

# --- Client (victim) ---
CYBERRECON_C2=http://127.0.0.1:8443

# --- AWS Relay (optional) ---
AWS_RELAY_HOST=0.0.0.0
AWS_RELAY_PORT=443
AWS_RELAY_C2_BACKEND=http://127.0.0.1:8443

# --- Lab CA (optional, for TLS) ---
# Path to PEM CA bundle for TLS verification.
# Leave unset to use the system CA store (recommended for prod).
# Set this only for a self-signed lab certificate authority.
# CYBERRECON_CA_BUNDLE=/etc/ssl/certs/lab-ca.pem

# --- TLS enforcement ---
# The operator CLI verifies TLS certificates by default.
# Setting CYBERRECON_REQUIRE_AUTH=false is for isolated local dev only.