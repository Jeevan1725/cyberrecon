# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
venv/
venv_new/
env/
.venv/


# PyInstaller
*.spec
*.spec.bak
dist/
build/

# Test & coverage
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.tox/

# SAST / security reports - final reports are committed as evidence,
# but transient/working reports are ignored.
reports/*.html
reports/*-fixed.*
reports/semgrep.txt
!reports/*.json
!reports/*.txt
!reports/.gitkeep

# Payloads (never commit — dangerous artifacts)
payloads/*
!payloads/.gitkeep

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
cyberrecon.log

# Env
.env
.env.local

# Docker
docker-compose.override.yml
